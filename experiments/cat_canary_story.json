{
  "_comment": "Рассказ (динамика) про кошку и канарейку. Отдельно от статики: события, ожидания, тики — это время, а не онтология.",
  "world": "cat_canary_world.json",
  "script": [
    {"do": "agent", "name": "кошка"},
    {"do": "agent", "name": "канарейка"},
    {"do": "please", "name": "кошка", "amount": 120},
    {"do": "ticks", "n": 2},
    {"do": "event", "subject": "кошка", "action": "любить", "obj": "канарейка",
     "text": "Кошка любила канарейку."},
    {"do": "event", "subject": "кошка", "action": "просить", "obj": "канарейка",
     "text": "Кошка попросила канарейку никому не рассказывать тайну."},
    {"do": "expect", "holder": "кошка", "target": "канарейка",
     "action": "рассказывать", "negated": true, "source": "просьба кошки"},
    {"do": "ticks", "n": "$between_ticks"},
    {"do": "event", "subject": "канарейка", "action": "рассказывать",
     "obj": "тайна", "text": "Канарейка рассказала тайну."},
    {"do": "ticks", "n": "$between_ticks"},
    {"do": "event", "subject": "кошка", "action": "съесть", "obj": "канарейка",
     "text": "Кошка съела канарейку."}
  ]
}